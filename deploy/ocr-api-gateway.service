[Unit]
Description=OCR API Gateway (FastAPI proxy hacia OCR.space)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ocrapi
Group=ocrapi
WorkingDirectory=/opt/ocr-api-gateway
EnvironmentFile=/opt/ocr-api-gateway/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ocr-api-gateway/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2

Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening: el servicio nunca escribe en disco (compresion en memoria, logs a stdout),
# asi que corre con el filesystem en solo lectura salvo /tmp privado.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
