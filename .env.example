# Obtene tu API key gratuita en https://ocr.space/ocrapi (formulario "Register")
OCR_SPACE_API_KEY=

OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# Limites del plan de OCR.space (ajustar si tenes un plan pago con limites distintos)
OCR_MAX_UPLOAD_BYTES=1048576
OCR_MAX_PDF_PAGES=3

# Comportamiento del cliente HTTP hacia OCR.space
OCR_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=2

# Piso de calidad/resolucion de la compresion automatica (ver README para el detalle)
OCR_MIN_JPEG_QUALITY=40
OCR_MIN_PDF_DPI=150
OCR_MIN_IMAGE_LONGEST_SIDE_PX=1500
OCR_MIN_IMAGE_SCALE_FACTOR=0.5

# Defaults del servicio para los parametros de OCR (el cliente puede sobreescribirlos por request)
OCR_DEFAULT_LANGUAGE=spa
OCR_DEFAULT_ENGINE=2

# Tope de subida cruda antes de intentar comprimir, para no cargar archivos gigantes en memoria
OCR_MAX_INPUT_BYTES=20971520

LOG_LEVEL=INFO

# Solo aplica al correr con Docker/docker-compose
UVICORN_WORKERS=2
